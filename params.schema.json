{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/<owner>/fin-proxy-optimizer/params.schema.json",
  "title": "fin-proxy-optimizer 3D single-fin contract",
  "description": "三维单肋稳态导热的参数契约。fin3d.py 求解、predict.py 代理预测共用。单位：mm / W / K。",
  "type": "object",
  "properties": {
    "L_mm": {
      "type": "number",
      "minimum": 30,
      "maximum": 100,
      "default": 50,
      "description": "肋高（沿流动方向的长度），mm。代理模型仅在此区间内有效。"
    },
    "t_mm": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 2,
      "description": "肋厚，mm。"
    },
    "h": {
      "type": "number",
      "minimum": 10,
      "maximum": 200,
      "default": 50,
      "description": "对流换热系数 W/(m^2*K)。自然对流 5-25，强制风冷 25-100，液冷/高风速 100-200。"
    },
    "k": {
      "type": "number",
      "minimum": 50,
      "maximum": 400,
      "default": 200,
      "description": "导热系数 W/(m*K)。钢~45，铝~200，铜~400。"
    },
    "W_mm": {
      "type": "number",
      "minimum": 1,
      "maximum": 200,
      "default": 20,
      "description": "肋宽（展向），mm。仅用于算材料体积 V=L*t*W，不进入导热求解（两侧对称、展向无梯度）。"
    },
    "Tb": {
      "type": "number",
      "minimum": 200,
      "maximum": 1500,
      "default": 350,
      "description": "根部定温，K。代理模型按 Tb=350、Tinf=300 训练，换 Tb/Tinf 需重算，不可线性缩放。"
    },
    "Tinf": {
      "type": "number",
      "minimum": 200,
      "maximum": 400,
      "default": 300,
      "description": "环境温度，K。"
    }
  },
  "required": ["L_mm", "t_mm", "h", "k"],
  "additionalProperties": false,
  "x-model-domain": {
    "note": "predict.py 的硬边界。任一参数越界即返回 status=\"超范围\"，不做外推。",
    "box": {
      "L_mm": [30, 100],
      "t_mm": [1, 5],
      "h": [10, 200],
      "k": [50, 400]
    },
    "fixed": {
      "W_mm": 20,
      "Tb": 350,
      "Tinf": 300
    }
  },
  "x-outputs": {
    "Q_W_per_m": "根部单位长度热流，W/m（沿展向每米）",
    "Q_W": "单肋总散热，W。Q_W = Q_W_per_m * W_m / 1000",
    "tip_T_K": "肋端平均温度，K",
    "V_mm3": "单肋材料体积，mm^3。V = L*t*W"
  }
}
